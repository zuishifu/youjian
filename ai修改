export default {
  async email(message, env, ctx) {
    const FORWARD_TO = env.FORWARD_TO || "your_real_email@gmail.com";
    const subject = message.headers.get("subject") || "无主题";
    const from = message.from;

    // 获取并尽量清洗正文
    const rawText = await streamToString(message.raw);
    const cleanBody = cleanEmailBody(rawText);

    // AI 处理
    let summary = "";
    try {
      const aiResponse = await env.AI.run("@cf/zai-org/glm-4.7-flash", {
        messages: [
          {
            role: "system",
            content: `你是 Cloudflare Workers 上的邮件安全审计与摘要专家。请用【简体中文】简洁回答。
执行两条指令：
1. 内容摘要：是谁发的？主要说了什么事？（如：服务器报警、账单待付、验证码登录等）
2. ⚡️关键数据提取：如果文中包含【验证码】、【OTP】、【金额】、【截止日期】、【订单号】，必须单独清晰列出。没有则不写。
要求：简洁、准确、重点突出。`
          },
          {
            role: "user",
            content: `邮件内容:\n${cleanBody.substring(0, 6000)}`
          }
        ]
      });
      summary = aiResponse.response || "AI 未返回有效摘要";
    } catch (e) {
      console.error("AI 处理失败:", e);
      summary = `AI 处理失败: ${e.message}`;
    }

    // 推送 + 转发
    ctx.waitUntil(Promise.all([
      sendToWeComBot(env, from, subject, summary),
      sendToTelegram(env, from, subject, summary)
    ]));

    await message.forward(FORWARD_TO);
  }
};

// ==================== 邮件清洗（尽量减少乱码） ====================
function cleanEmailBody(raw) {
  try {
    const { headers, body } = splitHeadersBody(raw);
    const contentType = (getHeader(headers, "content-type") || "").toLowerCase();
    const transferEncoding = (getHeader(headers, "content-transfer-encoding") || "").toLowerCase();

    // 处理 multipart
    if (contentType.includes("multipart")) {
      const boundaryMatch = contentType.match(/boundary="?([^";\s]+)"?/i);
      if (boundaryMatch) {
        const boundary = boundaryMatch[1];
        const parts = body.split("--" + boundary);
        let bestPart = null;

        for (const part of parts) {
          if (!part.trim() || part.trim() === "--") continue;
          const p = splitHeadersBody(part);
          const pType = (getHeader(p.headers, "content-type") || "").toLowerCase();

          if (pType.includes("text/plain")) {
            bestPart = p;
            break;
          }
          if (pType.includes("text/html") && !bestPart) {
            bestPart = p;
          }
        }

        if (bestPart) {
          const pEncoding = getHeader(bestPart.headers, "content-transfer-encoding");
          const charset = extractCharset(getHeader(bestPart.headers, "content-type") || "");
          return decodeContent(bestPart.body, pEncoding, charset);
        }
      }
    }

    // 普通邮件
    const charset = extractCharset(contentType);
    return decodeContent(body, transferEncoding, charset);
  } catch (e) {
    console.error("邮件解析错误:", e);
    return raw.length > 2000 ? raw.substring(0, 2000) : raw;
  }
}

function extractCharset(contentType) {
  const match = contentType.match(/charset=["']?([^\s;"']+)/i);
  return match ? match[1].toLowerCase() : "utf-8";
}

function splitHeadersBody(text) {
  let idx = text.indexOf("\r\n\r\n");
  if (idx === -1) idx = text.indexOf("\n\n");
  if (idx !== -1) {
    const separatorLength = text[idx] === "\r" ? 4 : 2;
    return {
      headers: text.substring(0, idx),
      body: text.substring(idx + separatorLength)
    };
  }
  return { headers: "", body: text };
}

function getHeader(headerText, key) {
  const regex = new RegExp(`^${key}:\\s*(.*)$`, "im");
  const match = headerText.match(regex);
  return match ? match[1].trim() : null;
}

function decodeContent(content, encoding, charset = "utf-8") {
  if (!content) return "";
  const enc = (encoding || "").toLowerCase();

  // Base64
  if (enc === "base64") {
    try {
      const clean = content.replace(/\s/g, "");
      const binary = atob(clean);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }
      // 尝试用指定 charset 解码
      try {
        return new TextDecoder(charset).decode(bytes);
      } catch {
        return new TextDecoder("utf-8").decode(bytes);
      }
    } catch (e) {
      return content;
    }
  }

  // Quoted-Printable
  if (enc === "quoted-printable") {
    try {
      let decoded = content
        .replace(/=\r?\n/g, "")
        .replace(/=([0-9A-F]{2})/gi, (_, hex) =>
          String.fromCharCode(parseInt(hex, 16))
        );
      // 再尝试 charset
      try {
        const bytes = new TextEncoder().encode(decoded);
        return new TextDecoder(charset).decode(bytes);
      } catch {
        return decoded;
      }
    } catch (e) {
      return content;
    }
  }

  return content;
}

async function streamToString(stream) {
  const chunks = [];
  const reader = stream.getReader();
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    chunks.push(value);
  }
  const decoder = new TextDecoder("utf-8");
  let result = "";
  for (const chunk of chunks) {
    result += decoder.decode(chunk, { stream: true });
  }
  result += decoder.decode();
  return result;
}

// ==================== 推送函数 ====================
async function sendToWeComBot(env, from, subject, summary) {
  const webhookUrl = env.WECOM_WEBHOOK_URL;
  if (!webhookUrl) return;

  const icon = getIcon(summary, subject);
  const textContent = `${icon} 新邮件到达
--------------------
发件人: ${from}
主　题: ${subject}
--------------------
${summary}
`;

  try {
    await fetch(webhookUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        msgtype: "text",
        text: { content: textContent }
      })
    });
  } catch (err) {
    console.error("企业微信推送失败:", err);
  }
}

async function sendToTelegram(env, from, subject, summary) {
  const token = env.TELEGRAM_BOT_TOKEN;
  const chatId = env.TELEGRAM_CHAT_ID;
  if (!token || !chatId) return;

  const icon = getIcon(summary, subject);
  const text = `${icon} <b>新邮件到达</b>
--------------------
<b>发件人:</b> ${from}
<b>主题:</b> ${subject}
--------------------
${summary}`;

  try {
    await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        chat_id: chatId,
        text: text,
        parse_mode: "HTML",
        disable_web_page_preview: true
      })
    });
  } catch (err) {
    console.error("Telegram 推送失败:", err);
  }
}

function getIcon(summary, subject) {
  const iconMap = [
    { icon: "🚨", keywords: ["报警", "紧急", "错误", "失败", "Alert", "Error", "Exception"] },
    { icon: "💰", keywords: ["金额", "账单", "支付", "Payment", "Bill", "发票"] },
    { icon: "🔐", keywords: ["验证码", "OTP", "Code", "登录", "验证"] },
    { icon: "📦", keywords: ["快递", "发货", "Delivery", "物流"] }
  ];
  for (const item of iconMap) {
    if (item.keywords.some(k => summary.includes(k) || subject.includes(k))) {
      return item.icon;
    }
  }
  return "📧";
}
